# Darshan SP Portfolio Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Free / Open Source LLM APIs (Optional: Built-in local grounded engine works with zero keys)
# Get a free 14,400 req/day key at https://console.groq.com
GROQ_API_KEY=

# Optional Hugging Face Token for serverless inference
HUGGINGFACE_API_KEY=

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:3000,https://darshan-portfolio.vercel.app

# Rate Limiting (Requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60
